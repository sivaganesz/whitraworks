# =======================================================
# WhitraWorks Staging Environment Configuration Template
# For Azure VM Deployment (stage.whitraworks.online)
# =======================================================

# 1. Environment & Network
NODE_ENV=staging
PORT=4000
ROOT_DOMAIN=stage.whitraworks.online
PLATFORM_DOMAIN=stage.whitraworks.online

# 2. Base URLs & Frontend Hosts (HTTP for initial bringup)
API_BASE_URL=http://api.stage.whitraworks.online
OPS_ADMIN_URL=http://ops.stage.whitraworks.online
TENANT_ADMIN_BASE_DOMAIN=stage.whitraworks.online

# 3. Database Credentials (PostgreSQL 16 Alpine container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_stage_db_password
POSTGRES_DB=whitraworks_stage

# 4. Redis Cache & Pub/Sub
REDIS_HOST=redis
REDIS_PORT=6379

# 5. Cryptographic Security Secrets (Min 32 characters each)
COOKIE_SECRET=replace_with_min_32_chars_random_cookie_secret
JWT_SECRET=replace_with_min_32_chars_random_jwt_secret
SESSION_SECRET=replace_with_min_32_chars_random_session_secret

# 6. Transactional Email Service (Resend - Verified)
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL="WhitraWorks <notifications@whitraworks.online>"
EMAIL_FROM="WhitraWorks <notifications@whitraworks.online>"

# 7. Initial Platform Superadmin Seed Credentials
INITIAL_SUPERADMIN_EMAIL=superadmin@whitraworks.online
INITIAL_SUPERADMIN_PASSWORD=replace_with_strong_superadmin_password
INITIAL_SUPERADMIN_FIRST_NAME=Root
INITIAL_SUPERADMIN_LAST_NAME=Superadmin

