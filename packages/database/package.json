{
  "name": "@whitraworks/database",
  "version": "0.1.0",
  "private": true,
  "description": "Database layer and Prisma client for WhitraWorks",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push --skip-generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prisma": "6.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
