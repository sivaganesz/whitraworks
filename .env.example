# Node Environment
NODE_ENV=development
PORT=4000

# Base URLs & Domains
API_BASE_URL=http://api.localhost:4000
OPS_ADMIN_URL=http://ops.localhost:3001
TENANT_ADMIN_BASE_DOMAIN=localhost:3000
ROOT_DOMAIN=whitraworks.com

# Database Connection URLs
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/whitraworks_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/whitraworks_test?schema=public"

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session Security & Secrets
SESSION_SECRET="whitraworks-super-secret-session-key-change-in-production-min32chars"
COOKIE_SECRET="whitraworks-cookie-signer-secret-min32chars"

# Initial Superadmin Seed Credentials
INITIAL_SUPERADMIN_EMAIL="superadmin@whitraworks.com"
INITIAL_SUPERADMIN_PASSWORD="ChangeMeImmediately123!"
INITIAL_SUPERADMIN_FIRST_NAME="Root"
INITIAL_SUPERADMIN_LAST_NAME="Superadmin"

