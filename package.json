{
  "name": "whitraworks",
  "version": "0.1.0",
  "private": true,
  "description": "WhitraWorks Configurable Multi-Tenant Business Operations Platform",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:int": "turbo test:int",
    "test:e2e": "turbo test:e2e",
    "db:generate": "pnpm --filter @whitraworks/database db:generate",
    "db:migrate": "pnpm --filter @whitraworks/database db:migrate",
    "db:seed": "pnpm --filter @whitraworks/database db:seed",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.3"
  }
}
